# video_tools .gitignore
# 原则：工具代码、文档、配置模板入库；本地机器配置、大二进制、运行产物不入库。

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/

# pip 构建产物（v2 P1-2 起 pyproject.toml 可本地 pip wheel，构建垃圾不入库）
build/
dist/
*.egg-info/

# 旧版备份文件（收编时已剔除，防御性保留规则）
*.bak
*.bak_v3*

# 本地配置（init.sh 从 config.example.json 生成，含机器特有开关，不入库）
config.local.json

# 可再生的公开字体二进制（blender_bridge/assets/ 的 Noto Sans CJK SC，
# 无代码引用；系统 /usr/share/fonts 或 fonts.google.com 可取）
*.otf
*.ttf

# 运行产物 / 大媒体（本仓只收工具，产物一律不入库）
out/
frames/
*.mp4
*.mov
*.webm
*.wav
*.flac
*.aup3
*.png

# 三大生成模块自建 venv（asr/tts/imgen init.sh 可能创建，不入库）
asr/.venv/
tts/.venv/
imgen/.venv/

# 测试 fixtures 反排除（防上面 *.wav/*.png 全局规则误杀测试小资产）
!asr/tests/fixtures/**
!tts/tests/fixtures/**
!imgen/tests/fixtures/**

# 内容寻址缓存（vtx 产物缓存，可再生，不入库）
cache/

# matting 平级克隆（init.sh --download 重建，不入库）
matting/MatAnyone2/
matting/BiRefNet_HR/
matting/__pycache__/

# matting/resolve_matte 运行产物（runner 日志、uinject.c 现场编译的二进制，可再生）
matting/resolve_matte/*.log
matting/resolve_matte/uinject
