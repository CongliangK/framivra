# video_tools .gitignore
# 原则：工具代码、文档、配置模板入库；本地机器配置、大二进制、运行产物不入库。

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/

# pip 构建产物（v2 P1-2 起 pyproject.toml 可本地 pip wheel，构建垃圾不入库）
build/
dist/
*.egg-info/

# 旧版备份文件（收编时已剔除，防御性保留规则）
*.bak
*.bak_v3*

# 本地配置（config.local.json 由 vt.py init 从 config.example.json 生成，含机器特有开关，不入库）
config.local.json

# 可再生的公开字体二进制（apps/blender-bridge/assets/ 的 Noto Sans CJK SC，
# 无代码引用；系统 /usr/share/fonts 或 fonts.google.com 可取）
*.otf
*.ttf

# 运行产物 / 大媒体（本仓只收工具，产物一律不入库）
out/
frames/
*.mp4
*.mov
*.webm
*.wav
*.flac
*.aup3
*.png

# 三大生成模块自建 venv（apps/asr|tts|imgen 的 init.sh 可能创建，不入库；P2a 迁移改锚）
apps/asr/.venv/
apps/tts/.venv/
apps/imgen/.venv/

# 测试 fixtures 反排除（防上面 *.wav/*.png 全局规则误杀测试小资产）
!tests/fixtures/gfx-environment/**/*.png
!apps/asr/tests/fixtures/**
!apps/tts/tests/fixtures/**
!apps/imgen/tests/fixtures/**

# 内容寻址缓存（vtx 产物缓存，可再生，不入库）
cache/
# Canonical cache-domain implementation is source, not runtime output.
!/vtx/cache/
# Cache-domain source tests are not generated runtime caches.
!tests/cache/

# matting 平级克隆（init.sh --download 重建，不入库；P2a 迁移 apps/ 改锚）
apps/matting/MatAnyone2/
apps/matting/BiRefNet_HR/
apps/matting/__pycache__/

# matting/resolve_matte 运行产物（runner 日志、uinject.c 现场编译的二进制，可再生）
apps/matting/resolve_matte/*.log
apps/matting/resolve_matte/uinject

# ZCode 会话目录（P6：验收 --ignored 干净门补录）
.zcode/

# tech-talk 模板包占位素材豁免（骨架开箱可 validate）
!templates/tech-talk/assets/presets/placeholders/*.mp4
!templates/tech-talk/assets/presets/placeholders/*.wav
.agents/

# experiments 第三方二进制与构建产物（#108：CEF worker 构建系统落位；
# 防 scripts/ci_checks.py 静态门 git ls-files 扫入数百 MB cef_binary 产物）
experiments/gfx_cef_worker/build/
experiments/gfx_cef_worker/cef_binary*/
experiments/gfx_electron_worker/node_modules
