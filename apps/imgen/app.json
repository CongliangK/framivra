{
  "name": "imgen",
  "version": "1.0.0",
  "kind": "app",
  "entry": {
    "cli": ["imgen_cli.py"]
  },
  "health": {
    "type": "command",
    "command": "imgen_cli.py --help"
  },
  "requires": {
    "core": ">=2.0.0",
    "binaries": ["ffmpeg", "ffprobe"],
    "python_packages": ["requests"]
  },
  "config_keys": ["imgen.api_base", "imgen.model_default", "imgen.price_per_image", "imgen.confirm_before_submit"],
  "docs": "README.md"
}
