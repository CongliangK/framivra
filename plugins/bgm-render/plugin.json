{
  "name": "bgm-render",
  "version": "1.2.0",
  "kind": "plugin",
  "entry": {
    "cli": []
  },
  "health": {
    "type": "command",
    "command": "health_check.py"
  },
  "requires": {
    "core": ">=2.0.0",
    "binaries": [
      "ffmpeg"
    ],
    "python_packages": [],
    "platforms": []
  },
  "config_keys": [
    "bgm.repo",
    "bgm.cli"
  ],
  "docs": "README.md",
  "extends": {
    "schema_keys": [
      {"path": "sources[]", "key": "bgm"}
    ],
    "hooks": ["validate", "probe_source", "prepare_source"]
  }
}
