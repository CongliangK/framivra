{
  "name": "framivra-dsh-sidebar",
  "version": "0.2.1",
  "description": "Framivra timeline preview, references and explicit semantic editing for official DSH",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.1" },
  "license": "MIT",
  "files": ["lib", "cordis.patch.yml", "LICENSE", "THIRD-PARTY-NOTICES.md", "README.md", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-client-ui-session", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-api-session-controller"],
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": { "@deepseek-ai/schemastery": "~3.19.0", "react": "18.3.1" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2"
  }
}
