  "shared_runtime_contract": {
    "geometry_units": "1280x720 author viewBox; uniform output scale1.5",
    "frame_domain": "global integer f in [0,3600); local f in [0,clip.dur)",
    "local_to_global": "global_f = entry.global_start_frame + local_f",
    "scene_frame": "find scene by in <= global_f < out; scene_f = global_f - scene.in",
    "input_sanitization": "Finite numeric input floored, then clamped to [0,dur-1]; NaN/nonfinite =>0. Validate entry start/dur as exact recipe values. Never clamp global_f at299.",
    "determinism": "Pure state from global_f + immutable inputs. No elapsed time, requestAnimationFrame clock, Math.random, or accumulated previous-frame state. Repeated/reverse/shuffled f must produce identical state.",
    "camera": "One cameraFromGlobalFrame result applies to all geometry in the shared world. Intentional foreground wing override [264,345) uses the same B transform on both bird pages. Source slips and subtitles use screen-space safe areas.",
    "mask_contract": "Each HTML page recreates its own SVG definitions from shared resolved world geometry. No cross-document url(#id), no duplicate opaque gate painted on bird pages. Body and wings consume bit-identical B visibility regions; retain page-specific ID prefixes to avoid collisions.",
    "no_new_renderer_protocol": true,
    "renderer_path": "Keep current navigation-based page protocol; expose existing __vtx_render(local_f) for deterministic testing only. Do not declare navfree eligibility, static spans, beginFrame or canvas-export fast paths."
  },
